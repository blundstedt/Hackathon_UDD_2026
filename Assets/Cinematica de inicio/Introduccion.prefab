  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2760627074589794648}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 30a8c8d1b0eb38646bf9aac1b4ea53e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Hackaton.Multiplayer.CampaignIntro
  pages:
  - image: {fileID: 21300000, guid: d7785b5ef4bec334dab7f5e85f7cf09b, type: 3}
    narration: {fileID: 8300000, guid: 9abd303179460144cb1efd5612f7a7ee, type: 3}
    subtitle: "La inteligencia artificial fue creada para facilitarnos la vida, pero termin\xF3 conquistando el 99% del mundo."
  - image: {fileID: 21300000, guid: 718f9017f8ac5be418164789aeeb13b3, type: 3}
    narration: {fileID: 8300000, guid: eaf498ef8b41f4749b1946653d7d9b92, type: 3}
    subtitle: "Al oficinista le quit\xF3 su trabajo, pero jam\xE1s imagin\xF3 que una simple taza de caf\xE9 se convertir\xEDa en su peor pesadilla."
  - image: {fileID: 21300000, guid: b6e2f91a9a84e6a4ba1b87f716c8fb7f, type: 3}
    narration: {fileID: 8300000, guid: 0467397dc26c8ae4fb11982bab341c67, type: 3}
    subtitle: "Al vagabundo le arrebat\xF3 su libertad y tranquilidad, sin imaginar que su vieja honda ser\xEDa el comienzo de una rebeli\xF3n."
  - image: {fileID: 21300000, guid: c7266a79d31640f48af1575dafec484a, type: 3}
    narration: {fileID: 8300000, guid: 8722b0186e26ecb45900a3705ea25c07, type: 3}
    subtitle: "Al abuelo lo declar\xF3 obsoleto, pero todav\xEDa cree que le queda una vida... y el poder de un buen bastonazo."
  - image: {fileID: 21300000, guid: fd3ff18ae8524bd42a7541cb72ac309e, type: 3}
    narration: {fileID: 8300000, guid: 624fe0a49f7d70d4a957029601077536, type: 3}
    subtitle: "Y as\xED, tres h\xE9roes completamente inesperados unieron fuerzas, decididos a recuperar todo lo que la inteligencia artificial les hab\xEDa arrebatado."
  overlay: {fileID: 8999488544364113667}
  group: {fileID: 4932939815078753604}
  current: {fileID: 7343771478961248542}
  incoming: {fileID: 7611259613422267088}
  subtitle: {fileID: 6732171988910791850}
